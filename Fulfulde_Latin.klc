VERSION	"1.0"

SHIFTSTATE
0	// Normal (sans touche de modification)
1	// Shift
2	// Ctrl
6	// AltGr (Ctrl+Alt)
7	// Shift + AltGr

LAYOUT
// VK_		Cap	0	1	2	6	7
// ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
02		1	1	!	-1	00b9	-1		// 1 ! ¹
03		1	2	@	-1	00b2	-1		// 2 @ ²
04		1	3	#	-1	00b3	-1		// 3 # ³
05		1	4	$	-1	20ac	-1		// 4 $ €
06		1	5	%	-1	00a5	-1		// 5 % ¥
07		1	6	^	-1	-1	-1		// 6 ^
08		1	7	&	-1	-1	-1		// 7 &
09		1	8	*	-1	00d7	-1		// 8 * ×
0a		1	9	(	-1	-1	-1		// 9 (
0b		1	0	)	-1	-1	-1		// 0 )
0c		0	-	_	-1	-1	-1		// - _
0d		0	=	+	-1	00b1	-1		// = + ±

// Rangée QWERTY avec accès direct Fulfulde
10		1	q	Q	-1	0253	0181		// q Q -> ɓ Ɓ
11		1	w	W	-1	-1	-1		// w W
12		1	e	E	-1	00e9	00c9		// e E -> é É
13		1	r	R	-1	-1	-1		// r R
14		1	t	T	-1	-1	-1		// t T
15		1	y	Y	-1	01b4	01b3		// y Y -> ƴ Ƴ
16		1	u	U	-1	00fa	00da		// u U -> ú Ú
17		1	i	I	-1	00ed	00cd		// i I -> í Í
18		1	o	O	-1	00f3	00d3		// o O -> ó Ó
19		1	p	P	-1	-1	-1		// p P
1a		0	0253	0181	-1	[	{		// [ { -> ɓ Ɓ (Touche directe)
1b		0	0257	018a	-1	]	}		// ] } -> ɗ Ɗ (Touche directe)

// Rangée ASDF avec accès direct Fulfulde
1e		1	a	A	-1	00e1	00c1		// a A -> á Á
1f		1	s	S	-1	-1	-1		// s S
20		1	d	D	-1	0257	018a		// d D -> ɗ Ɗ
21		1	f	F	-1	-1	-1		// f F
22		1	g	G	-1	-1	-1		// g G
23		1	h	H	-1	-1	-1		// h H
24		1	j	J	-1	-1	-1		// j J
25		1	k	K	-1	-1	-1		// k K
26		1	l	L	-1	-1	-1		// l L
27		0	014b	014a	-1	;	:		// ; : -> ŋ Ŋ (Touche directe)
28		0	2019	0022	-1	'	"		// ' " -> ’ " (Hamza direct)

// Rangée ZXCV avec accès direct Fulfulde
2c		1	z	Z	-1	-1	-1		// z Z
2d		1	x	X	-1	01b4	01b3		// x X -> ƴ Ƴ
2e		1	c	C	-1	-1	-1		// c C
2f		1	v	V	-1	-1	-1		// v V
30		1	b	B	-1	0253	0181		// b B -> ɓ Ɓ
31		1	n	N	-1	014b	014a		// n N -> ŋ Ŋ
32		1	m	M	-1	-1	-1		// m M
33		0	,	<	-1	-1	-1		// , <
34		0	.	>	-1	-1	-1		// . >
35		0	/	?	-1	-1	-1		// / ?
39		0	0020	0020	0020	-1	-1		// Espace

