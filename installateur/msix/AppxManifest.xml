<?xml version="1.0" encoding="utf-8"?>
<!--
  Paquet MSIX de Fulfulde Keyboard pour le Microsoft Store.
  installateur\fabriquer_msix.ps1 remplace les valeurs {{...}} : l'identité du
  produit donnée par l'Espace partenaires (Nom, Éditeur, Nom d'éditeur affiché)
  et la version.

  Le programme tourne en confiance totale (runFullTrust) : son crochet clavier
  et ses frappes sont ceux d'un programme de bureau. Il est déclaré « win32App »
  (uap10:RuntimeBehavior) : Windows ne virtualise ni son registre HKCU ni son
  AppData, comme pour l'installateur .exe. C'est là que Windows range la liste
  Win + Espace (FUL) et le correcteur orthographique, que les autres
  applications doivent voir. Le Store a refusé la capacité qui levait la
  virtualisation (rapport de certification du 30/09/2026, 10.6.3) : le paquet
  ne la demande plus.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">

  <Identity Name="{{NOM}}" Publisher="{{EDITEUR}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Fulfulde Keyboard</DisplayName>
    <PublisherDisplayName>{{EDITEUR_AFFICHE}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Clavier pulaar (fulfulde) : lettres ɓ ɗ ŋ ƴ ñ, suggestions et correction de mots pulaar quand FUL est choisi dans Win + Espace.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <Application Id="FulfuldeKeyboard" Executable="FulfuldeKeyboard.exe"
      uap10:RuntimeBehavior="win32App" uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Fulfulde Keyboard"
        Description="Clavier pulaar (fulfulde) : lettres, suggestions et correction."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Démarre avec Windows ; l'utilisateur le règle dans Paramètres > Applications > Démarrage.
             Avec le paramètre « demarrage », il reste discret ; « Ouvrir » montre ses paramètres. -->
        <desktop:Extension Category="windows.startupTask" Executable="FulfuldeKeyboard.exe"
          uap10:RuntimeBehavior="win32App" uap10:TrustLevel="mediumIL" uap10:Parameters="--demarrage">
          <desktop:StartupTask TaskId="FulfuldeKeyboard" Enabled="true" DisplayName="Fulfulde Keyboard" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
