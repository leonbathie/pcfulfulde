<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath « programme » : le moteur du clavier et le
     correcteur orthographique, fabriqués par GitHub Actions
     (.github/workflows/installateur.yml), avant d'entrer dans l'installateur. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ClavierPulaar.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="correcteur_pulaar.dll">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
